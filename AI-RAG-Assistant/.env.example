# Embedding model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local LLM (GGUF path)
LLM_MODEL_PATH=models/llama-3-8b-instruct.Q4_K_M.gguf
LLM_N_CTX=4096
LLM_TEMPERATURE=0.2

# RAG settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# Optional: use API LLM instead of local GGUF
USE_API_LLM=false
OPENAI_API_KEY=
