# ---------------------------------------------------------------------------
# AI Agentic Studio - configuration
# Copy to .env and edit. Every value below has a working default, so the
# project runs offline with zero keys using the deterministic "echo" provider.
# ---------------------------------------------------------------------------

# --- LLM routing ------------------------------------------------------------
# Comma-separated provider chain, tried in order with automatic failover.
# Available: echo | openai | anthropic | gemini | ollama | llamacpp
STUDIO_LLM_PROVIDERS=echo
STUDIO_LLM_TEMPERATURE=0.2
STUDIO_LLM_MAX_TOKENS=1024
STUDIO_LLM_TIMEOUT_S=60
STUDIO_LLM_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LLAMACPP_MODEL_PATH=models/llama-3-8b-instruct.Q4_K_M.gguf
LLAMACPP_N_CTX=4096

# --- Caching ----------------------------------------------------------------
STUDIO_CACHE_ENABLED=true
STUDIO_CACHE_SEMANTIC=true
STUDIO_CACHE_SIMILARITY_THRESHOLD=0.95
STUDIO_CACHE_TTL_S=3600

# --- Embeddings / retrieval -------------------------------------------------
# hashing = offline deterministic (no download); sentence-transformers = real model
STUDIO_EMBEDDING_BACKEND=hashing
STUDIO_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STUDIO_EMBEDDING_DIM=384

STUDIO_CHUNK_STRATEGY=recursive
STUDIO_CHUNK_SIZE=600
STUDIO_CHUNK_OVERLAP=80
STUDIO_PARENT_CHUNK_SIZE=2400

STUDIO_RETRIEVAL_TOP_K=8
STUDIO_RETRIEVAL_FETCH_K=30
STUDIO_HYBRID_ENABLED=true
STUDIO_HYBRID_DENSE_WEIGHT=0.6
STUDIO_GRAPH_RAG_ENABLED=true

# none | lexical | cross-encoder | llm
STUDIO_RERANKER=lexical
STUDIO_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# none | rewrite | multi-query | hyde | decompose
STUDIO_QUERY_TRANSFORM=multi-query
STUDIO_QUERY_VARIANTS=3

# --- Agents -----------------------------------------------------------------
STUDIO_AGENT_MAX_STEPS=12
STUDIO_AGENT_PARALLEL_TOOLS=true
STUDIO_AGENT_TOOL_TIMEOUT_S=30
STUDIO_AGENT_TOOL_RETRIES=1
# Comma-separated allowlist; empty = all registered tools
STUDIO_AGENT_ALLOWED_TOOLS=
STUDIO_HITL_ENABLED=true

# --- Tools ------------------------------------------------------------------
# tavily | duckduckgo | offline
STUDIO_SEARCH_PROVIDER=offline
TAVILY_API_KEY=
STUDIO_HTTP_ALLOWED_HOSTS=api.github.com,jsonplaceholder.typicode.com
STUDIO_PYTHON_EXEC_TIMEOUT_S=10
STUDIO_SQL_DATABASE_URL=

# --- Guardrails -------------------------------------------------------------
STUDIO_GUARDRAILS_ENABLED=true
# redact | block | off
STUDIO_PII_MODE=redact
STUDIO_MODERATION_MODE=block
STUDIO_MAX_INPUT_CHARS=20000

# --- Observability ----------------------------------------------------------
STUDIO_TRACING_ENABLED=true
STUDIO_TRACE_SINK=jsonl
STUDIO_LOG_LEVEL=INFO
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-agentic-studio
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- API --------------------------------------------------------------------
STUDIO_API_HOST=0.0.0.0
STUDIO_API_PORT=8100
# Comma-separated keys. Empty = auth disabled (local dev only).
STUDIO_API_KEYS=
STUDIO_RATE_LIMIT_PER_MINUTE=60
STUDIO_CORS_ORIGINS=*
